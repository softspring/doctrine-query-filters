{
    "name": "softspring/doctrine-query-filters",
    "description": "This library adds a new filter for doctrine queries",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "doctrine/orm": "^2.11|^3.0",
        "symfony/form": "^6.4|^7.4|^8.0",
        "symfony/http-foundation": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\DoctrineQueryFilters\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\Component\\DoctrineQueryFilters\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
